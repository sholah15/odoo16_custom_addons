<?xml version="1.0"?>

<odoo>
	<record id="credentials_googlesheets_tree" model="ir.ui.view">
		<field name="name">credentials.googlesheets.tree</field>
		<field name="model">credentialsgooglesheets</field>
		<field name="arch" type="xml">
			<tree>
				<field name="name"/>
                <field name="credentials_type"/>
				<field name="aktif" widget="boolean_toggle"/>
			</tree>
		</field>
	</record>

	<record id="credentials_googlesheets_form" model="ir.ui.view">
		<field name="name">credentials.googlesheets.form</field>
		<field name="model">credentialsgooglesheets</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<group string="Credentials">
						<field name="name"/>
                        <field name="credentials_type"/>
						<field name="aktif" widget="boolean_toggle"/>
                        <field name="credentials_code" widget="text"/>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record model='ir.actions.act_window' id='credentials_googlesheets_action'>
        <field name="name">Credentials</field>
        <field name="res_model">credentialsgooglesheets</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form</field>
    </record>

		<menuitem id="menu_credentials"
			parent="query_deluxe_inherit.menu_configuration" 
			action="query_deluxe_inherit.credentials_googlesheets_action" 
			sequence="1" 
			groups="query_deluxe.group_query_deluxe"/>

</odoo>